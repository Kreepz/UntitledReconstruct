#root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: stretch;
    justify-content: center;
    min-width: 100%;
    min-height: 100%;
    align-self: auto;
}

.base-page {
    position: absolute;
    width: 95%;
    height: 95%;
    background-color: rgba(255, 255, 255, 0);
    align-self: center;
    justify-content: flex-start;
    align-content: flex-start;
}

.hide {
    display: none;
}

.menu-title {
}

.game-title {
    font-size: 90px;
    color: rgb(255, 255, 255);
    background-color: rgb(41, 72, 82);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    align-items: center;
    max-width: 100%;
    align-self: center;
}

.navigation-button {
    background-color: rgb(22, 89, 94);
    color: rgb(255, 255, 255);
    font-size: 50px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    transition-duration: 0.1s;
    height: auto;
}

.navigation-button.return {
    background-color: rgb(94, 24, 22);
}

.navigation-button:hover {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    transition-duration: 0.25s;
    rotate: 1deg;
    letter-spacing: 5px;
}

.navigation-button:active {
    transition-duration: 0.1s;
    scale: 0.9 0.9 0.9;
}

.tab-header {
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    justify-content: flex-start;
    white-space: normal;
    min-height: auto;
    max-height: none;
    align-items: center;
    align-self: flex-start;
    font-size: 60px;
    background-color: rgb(47, 137, 104);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    margin-left: 1%;
    margin-top: 1%;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.menu-content-tab {
    flex-grow: 1;
    min-width: auto;
    width: 95%;
    height: 95%;
    max-height: 95%;
    max-width: 95%;
    justify-content: flex-start;
    align-self: center;
    display: flex;
    background-color: rgba(31, 106, 95, 0.251);
    border-top-width: 25px;
    border-right-width: 25px;
    border-bottom-width: 25px;
    border-left-width: 25px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.tab-button {
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgb(65, 125, 97);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    justify-content: flex-start;
    align-self: center;
    transition-duration: 0.1s;
}

.tab-button.return {
    background-color: rgb(120, 13, 12);
}

.tab-button:hover {
    scale: 1.1 1.1 1.1;
    letter-spacing: 1px;
    transition-duration: 0.25s;
}

.tab-button:active {
    transition-duration: 0.1s;
    scale: 0.9 0.9 0.9;
}
