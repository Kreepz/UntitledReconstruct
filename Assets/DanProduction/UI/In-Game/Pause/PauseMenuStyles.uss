#root {
    align-items: center;
}

.main-panel {
    width: 90%;
    height: 90%;
    flex-shrink: 0;
    align-items: center;
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
}

.panel-title {
    color: rgb(255, 255, 255);
    font-size: 60px;
    -unity-font-style: bold;
}

.action-buttons {
    align-self: auto;
    font-size: 30px;
    background-color: rgb(22, 89, 94);
    color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    transition-duration: 0.1s;
}

.action-buttons:hover {
    transition-duration: 0.25s;
    scale: 1.1 1.1 1.1;
}

.action-buttons:active {
    scale: 0.9 0.9 0.9;
    transition-duration: 0.1s;
}

.content-panel {
    background-color: rgba(84, 108, 152, 0.502);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.content-title {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 40px;
    white-space: normal;
}

.content-description {
    color: rgb(255, 255, 255);
    font-size: 25px;
    white-space: normal;
}

.content-thumbnail {
    aspect-ratio: 1;
}

.content-metadata {
    color: rgb(255, 255, 255);
    font-size: 20px;
}
