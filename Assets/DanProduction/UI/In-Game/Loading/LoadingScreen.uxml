<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/DanProduction/UI/In-Game/Loading/LoadingScreenStyles.uss?fileID=7433441132597879392&amp;guid=fede7ae5068698043a810933f9986b69&amp;type=3#LoadingScreenStyles"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="top-region" style="flex-grow: 1; flex-direction: row; height: 10%;">
            <ui:VisualElement name="left-region" style="align-items: flex-start; justify-content: flex-start; padding-top: 30px; padding-left: 30px; flex-grow: 0;">
                <ui:Button text="Exit to main menu" name="exit-button" class="button exit-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-region" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="middle-region" style="height: 70%;">
            <ui:VisualElement name="level-profile-container" style="justify-content: flex-end; align-items: center; flex-grow: 1;">
                <ui:VisualElement name="label-container" class="main-text-container">
                    <ui:Label text="My awesome level" name="level-title" class="title-label"/>
                    <ui:Label text="Danone" name="level-creator" class="subtitle-label"/>
                </ui:VisualElement>
                <ui:Image source="project://database/Assets/DanProduction/UI/images/1-1level-thumbnail.png?fileID=2800000&amp;guid=b8320e20fe7db384aaf7aac564b71472&amp;type=3#1-1level-thumbnail" name="level-profile-image" class="profile-image"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-region" style="height: 20%; flex-direction: row;">
            <ui:VisualElement name="left-region" style="flex-grow: 1; width: 33%;"/>
            <ui:VisualElement name="middle-region" style="flex-grow: 1; width: 33%;">
                <ui:Label text="Loading assets." name="current-action" class="current-action-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-region" style="flex-grow: 1; justify-content: center; align-items: center; width: 33%;">
                <ui:Button text="Start" name="play-button" class="play-button button" style="align-self: auto; display: flex;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
