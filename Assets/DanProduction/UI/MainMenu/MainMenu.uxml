<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="author-profile-danone" src="project://database/Assets/DanProduction/UI/MainMenu/Misc/author-profile-danone.uxml?fileID=9197481963319205126&amp;guid=b3aeea1e36d252240acbced85440042c&amp;type=3#author-profile-danone"/>
    <Style src="project://database/Assets/DanProduction/UI/MainMenu/LevelBrowser/LevelPreviewStyle.uss?fileID=7433441132597879392&amp;guid=95e1ce5a961afd84b985b051360c0f67&amp;type=3#LevelPreviewStyle"/>
    <Style src="project://database/Assets/DanProduction/UI/MainMenu/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=788bbf5770e67034b8c4a7c01efd97ac&amp;type=3#MainMenuStyle"/>
    <Style src="project://database/Assets/DanProduction/UI/MainMenu/LevelBrowser/LevelBrowserStyles.uss?fileID=7433441132597879392&amp;guid=44836ff17a614a74897f2c283b8d5fdb&amp;type=3#LevelBrowserStyles"/>
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center;">
        <ui:VisualElement name="start-menu" class="base-page" style="flex-grow: 0; top: auto; flex-direction: column; display: flex;">
            <ui:VisualElement name="top" style="flex-grow: 1; max-height: 25%; min-height: 12%;">
                <ui:Label text="Untitled Reconstruct" name="title-label" class="main-title game-title" style="border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; background-size: 100% 100%; padding-top: 35px; padding-right: 35px; padding-bottom: 35px; padding-left: 35px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; -unity-text-align: upper-center;"/>
            </ui:VisualElement>
            <ui:VisualElement name="centre" style="flex-grow: 1; height: 50%; align-items: center; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; justify-content: flex-end; color: rgb(255, 255, 255); align-self: auto;">
                <ui:VisualElement name="navigation-container" style="flex-grow: 0; background-color: rgb(93, 118, 118); width: 35%; height: 90%; align-self: flex-start; align-content: flex-start; justify-content: space-evenly; align-items: stretch; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                    <ui:Button text="Browse levels" name="browse-level" class="navigation-button" style="height: auto;"/>
                    <ui:Button text="Download levels" name="download-level" enabled="false" class="navigation-button" style="height: auto;"/>
                    <ui:Button text="Settings" name="settings-button" enabled="false" class="navigation-button" style="height: auto; display: flex; visibility: visible;"/>
                    <ui:Button text="Quit" name="quit-button" class="return navigation-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom" style="flex-grow: 1; max-height: 15%; min-height: 12%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="level-browser" class="base-page" style="flex-grow: 1; display: none; justify-content: center; align-items: stretch;">
            <ui:VisualElement name="content-tab" class="menu-content-tab">
                <ui:VisualElement name="top" style="flex-grow: 1; max-height: 15%; height: 7%; min-height: 10%; flex-direction: row; max-width: none; width: 100%; align-items: center; justify-content: flex-start;">
                    <ui:VisualElement name="left-region" style="flex-grow: 1; align-items: auto;">
                        <ui:Label text="Level Browser" name="tab-header" class="tab-header"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="right-region" style="flex-grow: 1; align-items: flex-end;">
                        <ui:Button text="Import Level" name="import-content-button" class="navigation-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="centre" style="flex-grow: 1; max-height: 90%; min-height: 40%; flex-direction: row;">
                    <ui:VisualElement name="level-container" style="flex-grow: 1; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; align-items: stretch; flex-direction: column; flex-wrap: wrap; justify-content: flex-start;">
                        <ui:ListView name="rows-list" fixed-item-height="360" allow-add="false" allow-remove="false" item-template="project://database/Assets/DanProduction/UI/MainMenu/LevelBrowser/BrowserCards/row-container.uxml?fileID=9197481963319205126&amp;guid=746987a2474f17e449471c81a2d26ad4&amp;type=3#row-container" show-bound-collection-size="false" focusable="false" selection-type="None"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="bottom" style="flex-grow: 1; max-height: 10%; min-height: 10%; flex-direction: row; align-self: flex-end; max-width: none; width: 100%; height: 10%;">
                    <ui:VisualElement name="left-region" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); max-width: 35%; align-items: auto; margin-left: 0; margin-bottom: 0; height: 100%; margin-top: 0; margin-right: 0; flex-direction: row; max-height: 100%;">
                        <ui:Button text="Return" name="return-button" class="return tab-button" style="justify-content: flex-end; align-self: flex-end; margin-bottom: 1%; margin-left: 1%; margin-right: 0; margin-top: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="central-region" style="flex-grow: 1; max-height: 100%; background-color: rgba(255, 255, 255, 0); height: 100%; justify-content: center; flex-direction: row; align-items: center;">
                        <ui:Label text="1" name="page-number-label" class="tab-information-label" style="padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px; margin-top: 6px; margin-right: 6px; margin-bottom: 6px; margin-left: 6px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="right-region" style="flex-grow: 1; height: 100%; background-color: rgba(248, 25, 25, 0); flex-direction: row; justify-content: flex-end; align-items: flex-end; max-width: 35%;">
                        <ui:VisualElement name="navigation-buttons" style="flex-grow: 1; flex-direction: row; max-width: 70%; justify-content: space-evenly; align-content: center; align-items: flex-end; width: 60%;">
                            <ui:Button text="Previous" name="previous-button" class="tab-button" style="min-width: 60px; max-width: 180px; width: 170px; font-size: 30px; margin-bottom: 1%;"/>
                            <ui:Button text="Next" name="next-button" class="tab-button" style="min-width: 60px; max-width: 180px; width: 170px; font-size: 30px; margin-bottom: 1%;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings-menu" class="base-page" style="flex-grow: 1; display: none; justify-content: center; align-items: stretch;">
            <ui:VisualElement name="content-tab" class="menu-content-tab">
                <ui:VisualElement name="top" style="flex-grow: 1; max-height: 25%; height: 20%; min-height: 10%; flex-direction: row;">
                    <ui:Label text="Settings" name="tab-header" class="tab-header"/>
                </ui:VisualElement>
                <ui:VisualElement name="centre" style="flex-grow: 1; max-height: 75%; height: 60%; min-height: 40%;"/>
                <ui:VisualElement name="bottom" style="flex-grow: 1; max-height: 25%; height: 10%; min-height: 10%; justify-content: flex-start; flex-direction: row; align-self: stretch; align-items: flex-end;">
                    <ui:Button text="Return" name="return-button" class="return tab-button" style="margin-bottom: 1%; margin-left: 1%; align-self: flex-end;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="level-preview" class="base-page" style="flex-grow: 1; display: none;">
            <ui:VisualElement name="content-tab" class="menu-content-tab">
                <ui:VisualElement name="top" style="flex-grow: 1; max-height: 15%; height: 7%; min-height: 10%; flex-direction: row; align-self: flex-start; max-width: none; width: 100%;">
                    <ui:Label text="Level preview" name="tab-header" class="tab-header"/>
                </ui:VisualElement>
                <ui:VisualElement name="centre" style="flex-grow: 1; max-height: 90%; min-height: 40%; flex-direction: row;">
                    <ui:VisualElement name="level-container" style="flex-grow: 1; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; align-items: stretch; flex-direction: column; flex-wrap: nowrap; justify-content: space-evenly;">
                        <ui:VisualElement name="info-container" style="flex-grow: 0; flex-direction: row; flex-shrink: 1;">
                            <ui:VisualElement name="level-profile" style="flex-grow: 0; background-color: rgba(84, 108, 152, 0.502); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(84, 108, 152); border-right-color: rgb(84, 108, 152); border-top-color: rgb(84, 108, 152); border-bottom-color: rgb(84, 108, 152); flex-direction: column; max-width: 70%; align-self: stretch; flex-shrink: 0; height: 500px; width: 70%;">
                                <ui:VisualElement name="main-data" style="flex-grow: 1; flex-direction: row;">
                                    <ui:Image source="project://database/Assets/DanProduction/UI/images/1-1level-thumbnail.png?fileID=2800000&amp;guid=b8320e20fe7db384aaf7aac564b71472&amp;type=3#1-1level-thumbnail" name="level-thumbnail" style="aspect-ratio: 1; max-width: 400px; max-height: 400px;"/>
                                    <ui:VisualElement name="caption-container" style="flex-grow: 1;">
                                        <ui:Label text="My awesome level" name="level-title" enable-rich-text="true" class="content-title" style="background-color: rgba(20, 95, 74, 0.749); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                                        <ui:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur tempor augue augue, quis finibus est facilisis et. Morbi sed ultrices est, eu pretium est. Sed sit amet tellus pharetra, lacinia nulla non, vestibulum ipsum. Donec a sodales neque. Nunc vitae laoreet mauris. Vestibulum pellentesque, sapien id feugiat hendrerit, purus sem placerat nunc, in laoreet magna justo pellentesque leo. Nullam sed justo congue, vestibulum lectus non, fringilla risus. Nulla facilisi. Nullam nisi odio, viverra sed quam eu, malesuada eleifend nisi. Curabitur finibus convallis rutrum. Aliquam ligula mi, aliquam eget erat sed, hendrerit vestibulum risus. Nullam nec felis bibendum, iaculis augue in, viverra eros. Nullam hendrerit, quam vitae pulvinar varius, purus magna ornare elit, at tincidunt tortor arcu tempor leo. Fusce id varius sem. Vestibulum varius ut lacus sit amet pellentesque. Etiam vulputate augue eu commodo sodales." name="level-description" class="content-desc" style="border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="metadata-container" style="flex-grow: 1; flex-direction: row; justify-content: flex-start; align-items: center;">
                                    <ui:DropdownField label="Version" choices="1,2" name="version-dropdown" focusable="false" class="dropdown-selector" style="color: rgb(0, 0, 0); height: 50px;"/>
                                    <ui:Button text="Delete level" name="delete-level-button" class="delete-button"/>
                                    <ui:Button text="Delete version" name="delete-version-button" class="delete-button"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="author-panel" style="flex-grow: 0; width: 500px; height: 500px; flex-shrink: 0;">
                                <ui:Instance template="author-profile-danone" name="author-profile-danone" style="width: 500px; height: 500px;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="bottom" style="flex-grow: 1; max-height: 10%; min-height: 10%; flex-direction: row; align-self: flex-end; max-width: none; width: 100%; height: 10%;">
                    <ui:VisualElement name="left-region" style="flex-grow: 1; max-width: 35%; align-items: auto; margin-left: 0; margin-bottom: 0; height: 100%; margin-top: 0; margin-right: 0; flex-direction: row; max-height: 100%;">
                        <ui:Button text="Return" name="return-button" class="return tab-button" style="justify-content: flex-end; align-self: flex-end; margin-bottom: 1%; margin-left: 1%; margin-right: 0; margin-top: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="central-region" style="flex-grow: 1; max-height: 100%; height: 100%; justify-content: flex-end;"/>
                    <ui:VisualElement name="right-region" style="flex-grow: 1; height: 100%; flex-direction: row; justify-content: center; align-items: flex-end; max-width: 35%;">
                        <ui:Button text="Play" name="play-button" class="play-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="overlay" class="base-page" style="flex-direction: column; display: none;">
            <ui:VisualElement name="top" style="flex-grow: 1;">
                <ui:VisualElement name="task-result-panel" style="flex-grow: 0; background-color: rgba(50, 50, 50, 0.749); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 140, 0); border-right-color: rgb(0, 140, 0); border-top-color: rgb(0, 140, 0); border-bottom-color: rgb(0, 140, 0); align-self: center; justify-content: flex-start; align-items: flex-start; min-width: 75%; max-width: 75%;">
                    <ui:VisualElement name="header" style="flex-direction: row; align-self: stretch;">
                        <ui:VisualElement name="left-region" style="flex-grow: 0; max-width: 10%; min-width: 10%;"/>
                        <ui:VisualElement name="middle-region" style="flex-grow: 1; max-width: 80%; align-items: center;">
                            <ui:Label text="Yo lol" name="result-caption" style="color: rgb(255, 255, 255); font-size: 64px; flex-wrap: wrap; white-space: normal; -unity-text-align: upper-center;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="right-region" style="flex-grow: 0; max-width: 10%; min-width: 10%;">
                            <ui:Button text="Close" name="close-button" enabled="true" class="tab-button return"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="Warnings: No versions found" name="warning-list" style="color: rgb(192, 96, 8); font-size: 42px; background-color: rgb(0, 0, 0);"/>
                    <ui:Label text="Errors: Installation folder invalid" name="error-list" style="font-size: 42px; color: rgb(194, 0, 0); background-color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
