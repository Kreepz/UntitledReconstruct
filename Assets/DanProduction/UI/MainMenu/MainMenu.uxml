        <ui:VisualElement name="menu-preview" class="base-page" style="flex-grow: 1;">
            <ui:VisualElement name="content-tab" class="menu-content-tab">
                <ui:VisualElement name="top" style="flex-grow: 1; max-height: 15%; height: 7%; min-height: 10%; flex-direction: row; align-self: flex-start; max-width: none; width: 100%;">
                    <ui:Label text="Level preview" name="tab-header" class="tab-header"/>
                </ui:VisualElement>
                <ui:VisualElement name="centre" style="flex-grow: 1; max-height: 90%; min-height: 40%; flex-direction: row;">
                    <ui:VisualElement name="level-container" style="flex-grow: 1; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; align-items: stretch; flex-direction: column; flex-wrap: nowrap; justify-content: space-evenly;">
                        <ui:VisualElement name="info-container" style="flex-grow: 1; flex-direction: row;">
                            <ui:VisualElement name="level-profile" style="flex-grow: 1; background-color: rgba(84, 108, 152, 0.502); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(84, 108, 152); border-right-color: rgb(84, 108, 152); border-top-color: rgb(84, 108, 152); border-bottom-color: rgb(84, 108, 152); flex-direction: column; max-width: 70%; align-self: stretch;">
                                <ui:VisualElement name="main-data" style="flex-grow: 1; flex-direction: row;">
                                    <ui:Image source="project://database/Assets/DanProduction/UI/MainMenu/images/1-1level-thumbnail.png?fileID=2800000&amp;guid=b8320e20fe7db384aaf7aac564b71472&amp;type=3#1-1level-thumbnail" name="thumbnail" style="aspect-ratio: 1; max-width: 400px; max-height: 400px;"/>
                                    <ui:VisualElement name="caption-container" style="flex-grow: 1;">
                                        <ui:Label text="My awesome level" name="level-title" enable-rich-text="true" style="font-size: 40px; color: rgb(255, 255, 255); flex-grow: 1; height: 15%;"/>
                                        <ui:Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur tempor augue augue, quis finibus est facilisis et. Morbi sed ultrices est, eu pretium est. Sed sit amet tellus pharetra, lacinia nulla non, vestibulum ipsum. Donec a sodales neque. Nunc vitae laoreet mauris. Vestibulum pellentesque, sapien id feugiat hendrerit, purus sem placerat nunc, in laoreet magna justo pellentesque leo. Nullam sed justo congue, vestibulum lectus non, fringilla risus. Nulla facilisi. Nullam nisi odio, viverra sed quam eu, malesuada eleifend nisi. Curabitur finibus convallis rutrum. Aliquam ligula mi, aliquam eget erat sed, hendrerit vestibulum risus. Nullam nec felis bibendum, iaculis augue in, viverra eros. Nullam hendrerit, quam vitae pulvinar varius, purus magna ornare elit, at tincidunt tortor arcu tempor leo. Fusce id varius sem. Vestibulum varius ut lacus sit amet pellentesque. Etiam vulputate augue eu commodo sodales." name="level-description" style="flex-wrap: wrap; white-space: normal; max-width: 100%; color: rgb(255, 255, 255); height: 75%; max-height: 80%; flex-shrink: 1;"/>
                                        <ui:Label text="Created by me" name="author-credits" style="color: rgb(255, 255, 255); height: 5%;"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="metadata-container" style="flex-grow: 1; flex-direction: row; justify-content: flex-start;">
                                    <ui:Label text="uploaded - 23/06/2026" name="upload-date" style="max-width: 50%; flex-shrink: 1; width: 50%; color: rgb(255, 255, 255);"/>
                                    <ui:VisualElement name="download-info" style="flex-grow: 1; max-width: 50%; flex-direction: row;">
                                        <ui:Label text="Downloaded -23/06/2026" name="download-date" style="max-width: none; width: auto; flex-shrink: 1; color: rgb(255, 255, 255);"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="author-profile" style="flex-grow: 1; background-color: rgba(248, 203, 219, 0.502); border-left-color: rgb(248, 203, 219); border-right-color: rgb(248, 203, 219); border-top-color: rgb(248, 203, 219); border-bottom-color: rgb(248, 203, 219); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; max-width: 35%;">
                                <ui:VisualElement name="info-container" style="flex-grow: 1; flex-direction: row;">
                                    <ui:VisualElement name="profile-page" style="flex-grow: 1; align-self: flex-start; max-width: 35%; width: 35%;">
                                        <ui:Label text="danone" name="username" style="align-self: flex-start;"/>
                                        <ui:Image name="profile-image" source="project://database/Assets/DanProduction/UI/MainMenu/images/subaru.jpg?fileID=2800000&amp;guid=21285ea7277bfd146b47e07a99bb041c&amp;type=3#subaru" style="aspect-ratio: 1; max-width: none; width: 250px; height: 150px;"/>
                                    </ui:VisualElement>
                                    <ui:Label text="&quot;HAPPY BIRTHDAY DANIEL!! did you really think I&apos;d let this day pass quietly!? I know the kind of power you vibe with, the kind that keeps climbing no matter what. So here&apos;s your gift, a profile picture wrapped in that same aura, use it anywhere, you know the rule, EVEN IF THE STAIRS NEVER END. WE KEEP CLIMBING!!!&quot;" name="about-me" style="flex-wrap: wrap; max-width: 65%; white-space: normal; width: 65%;"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="other-levels" style="flex-grow: 1; background-color: rgb(84, 108, 152); border-left-color: rgb(84, 108, 152); border-right-color: rgb(84, 108, 152); border-top-color: rgb(84, 108, 152); border-bottom-color: rgb(84, 108, 152); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="level-options" style="flex-grow: 1; justify-content: center; flex-direction: row;">
