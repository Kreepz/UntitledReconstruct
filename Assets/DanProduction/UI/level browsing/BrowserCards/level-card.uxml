<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/DanProduction/UI/level%20browsing/LevelBrowserStyles.uss?fileID=7433441132597879392&amp;guid=44836ff17a614a74897f2c283b8d5fdb&amp;type=3#LevelBrowserStyles"/>
    <ContentCard name="level-card" class="level-card">
        <ui:Image source="project://database/Assets/DanProduction/UI/images/1-1level-thumbnail.png?fileID=2800000&amp;guid=b8320e20fe7db384aaf7aac564b71472&amp;type=3#1-1level-thumbnail" name="thumbnail" scale-mode="ScaleToFit" style="flex-shrink: 1; flex-grow: 1; flex-direction: column; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%;"/>
        <ui:VisualElement name="caption-container" style="flex-grow: 1; background-color: rgba(113, 113, 113, 0.502); max-width: none; width: 100%; max-height: 20%;">
            <ui:Label text="My amazing levelkkkkkkkkk" name="level-name" style="align-self: stretch; color: rgb(255, 255, 255); font-size: 15px; flex-shrink: 1; flex-grow: 1; text-overflow: ellipsis; overflow: hidden;"/>
            <ui:Label text="Creator : Me" name="credits-text" style="color: rgb(255, 255, 255); flex-shrink: 1; align-self: flex-start; font-size: 12px; flex-grow: 1;"/>
        </ui:VisualElement>
    </ContentCard>
</ui:UXML>
